<?xml version="1.0" encoding="UTF-8"?>
<!--
  Update information for the CopyInsert extension: this file describes release 1.1.0.
  Save it in the root of the repository under the name CopyInsert.update.xml.
  For this very first release it can be committed together with the extension files, because
  no installed copy knows the address of this file yet. For every later release, commit the
  update file only AFTER the release (with its .oxt) exists on GitHub.
  Keep <identifier> exactly as in description.xml, and the minimum LibreOffice version
  in <dependencies> equal to the one in description.xml.
-->
<description xmlns="http://openoffice.org/extensions/update/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:lo="http://libreoffice.org/extensions/description/2011">
  <identifier value="org.libreoffice.extension.copyinsert"/>
  <version value="1.1.0"/>
  <dependencies>
    <lo:LibreOffice-minimal-version value="26.8" d:name="LibreOffice 26.8"/>
  </dependencies>
  <update-download>
    <src xlink:href="https://github.com/JFG-CopyInsert/CopyInsert/releases/download/v1.1.0/CopyInsert-1_1_0.oxt"/>
  </update-download>
  <release-notes>
    <src xlink:href="https://github.com/JFG-CopyInsert/CopyInsert/releases/tag/v1.1.0" lang="en"/>
    <src xlink:href="https://github.com/JFG-CopyInsert/CopyInsert/releases/tag/v1.1.0" lang="fr"/>
  </release-notes>
</description>
