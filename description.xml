<?xml version="1.0" encoding="UTF-8"?>
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:lo="http://libreoffice.org/extensions/description/2011">

  <!-- Unique Extension Identifier -->
  <identifier value="org.libreoffice.extension.copyinsert"/>

  <!-- Extension Version -->
  <version value="1.1.0"/>

  <!-- Display Name in Extension Manager -->
  <display-name>
    <name lang="en">CopyInsert - Copy, Cut and Move with Insert for Calc</name>
    <name lang="fr">CopyInsert - Copier, couper et déplacer avec insertion pour Calc</name>
  </display-name>

  <!-- Publisher Information -->
  <publisher>
    <name xlink:href="https://extensions.libreoffice.org">JFG</name>
  </publisher>

  <!-- Where LibreOffice looks for a newer release (Extension Manager > Check for Updates) -->
  <update-information>
    <src xlink:href="https://raw.githubusercontent.com/JFG-CopyInsert/CopyInsert/main/CopyInsert.update.xml"/>
  </update-information>

  <!-- Minimum Requirement -->
  <dependencies>
    <lo:LibreOffice-minimal-version value="26.8" d:name="LibreOffice 26.8"/>
  </dependencies>

  <!-- License Agreement -->
  <registration>
    <simple-license accept-by="user" default-license-id="en" suppress-on-update="true">
      <license-text xlink:href="license/license_en.txt" lang="en" license-id="en"/>
      <license-text xlink:href="license/license_fr.txt" lang="fr" license-id="fr"/>
    </simple-license>
  </registration>

  <!-- Detailed Description Text Files -->
  <extension-description>
    <src lang="en" xlink:href="description/description_en.txt"/>
    <src lang="fr" xlink:href="description/description_fr.txt"/>
  </extension-description>

</description>