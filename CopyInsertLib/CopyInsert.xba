&apos;=====================================================================
&apos;  4. Menu commands: remember the source and start range selection
&apos;     ArmPendingEx(cut, move, before, paste special, shift cells right)
&apos;     &quot;Before&quot; = above (rows, cells) or to the left (columns, cells)
&apos;=====================================================================
&apos; --- rows / columns (after / before); cells use the CELLS_SHIFT_DOWN default ---
&apos; True if the &quot;before&quot; macros (and so the shortcut keys) shift cells down, False if right.
&apos; The Edit menu uses it to put the shortcut label on the right entry.
Function CellsShiftDown() As Boolean
    CellsShiftDown = CELLS_SHIFT_DOWN
End Function

Sub StartCopy()
    ArmPending False, False, False, Not CELLS_SHIFT_DOWN
End Sub

Sub StartCopyBefore()
    ArmPending False, True, False, Not CELLS_SHIFT_DOWN
End Sub

Sub StartPasteSpecial()
    ArmPending False, False, True, Not CELLS_SHIFT_DOWN
End Sub

Sub StartPasteSpecialBefore()
    ArmPending False, True, True, Not CELLS_SHIFT_DOWN
End Sub

Sub StartCut()
    ArmPending True, False, False, Not CELLS_SHIFT_DOWN
End Sub

Sub StartCutBefore()
    ArmPending True, True, False, Not CELLS_SHIFT_DOWN
End Sub

Sub StartMove()
    ArmPendingEx True, True, False, False, Not CELLS_SHIFT_DOWN
End Sub

Sub StartMoveBefore()
    ArmPendingEx True, True, True, False, Not CELLS_SHIFT_DOWN
End Sub

&apos; --- sheets: copy the selected sheets before / after the destination sheet ---
Sub StartCopySheets()
