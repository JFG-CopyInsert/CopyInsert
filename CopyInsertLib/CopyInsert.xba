&apos; Wording of the prompt window (kept short: the window is narrow)
Function BuildTitle(sMode As String, bBefore As Boolean, bSpecial As Boolean, bRight As Boolean) As String
    Dim sWhere As String, sPrefix As String
    If sMode = &quot;SHEETS&quot; Then
        If bBefore Then sWhere = Txt(&quot;t.before&quot;) Else sWhere = Txt(&quot;t.after&quot;)
        BuildTitle = Txt(&quot;t.insert&quot;) &amp; sWhere &amp; Txt(&quot;t.clicksheet&quot;)
        Exit Function
    End If
    If sMode = &quot;CELLS&quot; Then
        If bRight Then
            If bBefore Then sWhere = Txt(&quot;t.left&quot;) Else sWhere = Txt(&quot;t.right&quot;)
        Else
            If bBefore Then sWhere = Txt(&quot;t.above&quot;) Else sWhere = Txt(&quot;t.below&quot;)
        End If
    ElseIf sMode = &quot;ROWS&quot; Then
        If bBefore Then sWhere = Txt(&quot;t.above&quot;) Else sWhere = Txt(&quot;t.below&quot;)
    Else
        If bBefore Then sWhere = Txt(&quot;t.left&quot;) Else sWhere = Txt(&quot;t.right&quot;)
    End If
    If bSpecial Then sPrefix = Txt(&quot;t.special&quot;) Else sPrefix = Txt(&quot;t.insert&quot;)
    BuildTitle = sPrefix &amp; sWhere &amp; Txt(&quot;t.click&quot;)
End Function

&apos; Opens the small &quot;click the destination&quot; window
Sub StartDestinationPick(oCtrl As Object, sTitle As String)
    Dim aArgs(1) As New com.sun.star.beans.PropertyValue
    aArgs(0).Name = &quot;Title&quot;
    aArgs(0).Value = sTitle
    aArgs(1).Name = &quot;CloseOnMouseRelease&quot;
    aArgs(1).Value = True
    oCtrl.startRangeSelection(aArgs())
End Sub

&apos; Copy / Cut / Paste special (no &quot;move&quot;)
Sub ArmPending(bCut As Boolean, bBefore As Boolean, bSpecial As Boolean, bRight As Boolean)
    ArmPendingEx bCut, False, bBefore, bSpecial, bRight
End Sub

Sub ArmPendingEx(bCut As Boolean, bMove As Boolean, bBefore As Boolean, bSpecial As Boolean, bRight As Boolean)
    Dim oDoc As Object, oCtrl As Object, oSel As Variant
    Dim aRaw As Variant, aR As Variant, nSheet As Long, sKind As String
    Dim sMode As String, sCut As String, sBefore As String, sSpecial As String
    Dim sRight As String

    If Not IsCalcDoc(ThisComponent) Then Exit Sub

    oDoc = ThisComponent
    oCtrl = oDoc.CurrentController
    oSel = oCtrl.Selection
    aRaw = ReadSelection(oSel, nSheet)      &apos; one range, or the ranges of a Ctrl selection
    If IsEmpty(aRaw) Then
        MsgBox Txt(&quot;msg.select&quot;), 48
        Exit Sub
    End If

    sKind = KindOfRanges(oDoc, nSheet, aRaw)
    If sKind = &quot;WHOLE&quot; Then
        MsgBox Txt(&quot;msg.wholesheet&quot;), 48
        Exit Sub
    ElseIf sKind = &quot;MIXED&quot; Then
        MsgBox Txt(&quot;msg.multi&quot;), 48
        Exit Sub
    End If

    If sKind = &quot;ROWS&quot; Then
        sMode = &quot;ROWS&quot;
        aR = NormalizeRanges(aRaw, 1)       &apos; sheet order, touching ranges merged
    ElseIf sKind = &quot;COLS&quot; Then
        sMode = &quot;COLS&quot;
        aR = NormalizeRanges(aRaw, 0)
    Else
        sMode = &quot;CELLS&quot;
        aR = aRaw
    End If
    If bCut Then bSpecial = False         &apos; a cut / move is always a plain move
    &apos; the &quot;cut&quot; field of the saved state: 0 = copy, 1 = cut, 2 = move
    If bMove Then
        sCut = &quot;2&quot;
    ElseIf bCut Then
        sCut = &quot;1&quot;
    Else
        sCut = &quot;0&quot;
    End If
    If bSpecial Then sSpecial = &quot;1&quot; Else sSpecial = &quot;0&quot;
    If bBefore Then sBefore = &quot;1&quot; Else sBefore = &quot;0&quot;
    If bRight Then sRight = &quot;1&quot; Else sRight = &quot;0&quot;

    SaveState oDoc, sMode &amp; &quot;|&quot; &amp; sCut &amp; &quot;|&quot; &amp; sBefore &amp; &quot;|&quot; &amp; sSpecial &amp; &quot;|&quot; &amp; sRight &amp; &quot;|&quot; &amp; _
              nSheet &amp; &quot;|&quot; &amp; RangesToString(aR)

    oSelListener = CreateUnoListener(&quot;RS_&quot;, &quot;com.sun.star.sheet.XRangeSelectionListener&quot;)
    oCtrl.addRangeSelectionListener(oSelListener)

    StartDestinationPick oCtrl, BuildTitle(sMode, bBefore, bSpecial, bRight)
End Sub

&apos; Sheets: remember the selected sheets (indexes) and open the destination window. The
&apos; destination is any cell of the sheet before (after) which the copies must go.
Sub ArmSheetCopy(bBefore As Boolean)
    Dim oDoc As Object, oCtrl As Object, aSh As Variant, sList As String, i As Long
    Dim sBefore As String, sRg As String

    If Not IsCalcDoc(ThisComponent) Then Exit Sub
    oDoc = ThisComponent
    oCtrl = oDoc.CurrentController
    aSh = ReadSheetSelection(oCtrl.Selection)
    If IsEmpty(aSh) Then
        MsgBox Txt(&quot;msg.nosheets&quot;), 48
        Exit Sub
    End If
    For i = 1 To UBound(aSh)                 &apos; the sheets must be consecutive
        If aSh(i) &lt;&gt; aSh(0) + i Then
            MsgBox Txt(&quot;msg.sheetgap&quot;), 48
            Exit Sub
        End If
    Next i
    sList = &quot;&quot;
    For i = 0 To UBound(aSh)
        If i &gt; 0 Then sList = sList &amp; &quot;,&quot;
        sList = sList &amp; aSh(i)
    Next i
    &apos; what is highlighted now, to be highlighted again on the first copy (or after an Undo)
    sRg = SelectedRangesOnSheet(oCtrl.Selection, aSh(0))
    If sRg &lt;&gt; &quot;&quot; Then sList = sList &amp; &quot;@&quot; &amp; sRg
    If bBefore Then sBefore = &quot;1&quot; Else sBefore = &quot;0&quot;

    SaveState oDoc, &quot;SHEETS|0|&quot; &amp; sBefore &amp; &quot;|0|0|&quot; &amp; aSh(0) &amp; &quot;|&quot; &amp; sList

    oSelListener = CreateUnoListener(&quot;RS_&quot;, &quot;com.sun.star.sheet.XRangeSelectionListener&quot;)
    oCtrl.addRangeSelectionListener(oSelListener)
    &apos; a click on a sheet tab changes the active sheet: that sheet is the destination
    oActListener = CreateUnoListener(&quot;AS_&quot;, &quot;com.sun.star.sheet.XActivationEventListener&quot;)
    oCtrl.addActivationEventListener(oActListener)

    StartDestinationPick oCtrl, BuildTitle(&quot;SHEETS&quot;, bBefore, False, False)
End Sub

Sub CancelPending()
    If Not IsCalcDoc(ThisComponent) Then Exit Sub
    ClearState ThisComponent
End Sub


&apos;=====================================================================
&apos;  5. Range-selection callbacks: the chosen cell = the destination
&apos;=====================================================================

&apos; Reads the chosen destination and returns it as plain numbers:
&apos; Array(sheet, firstColumn, firstRow, lastColumn, lastRow).
&apos; Returns Empty if it is not a usable cell (empty text, a click on a button
&apos; of the small window, a bad sheet name...)
Function ResolveDestination(oDoc As Object, oEvent As Object, nDefSheet As Long) As Variant
    Dim sDesc As String, sSheetName As String, sCell As String
    Dim p As Long, i As Long
    Dim oSheet As Object, oRange As Object, oA As Object

    On Error GoTo Bad
    sDesc = oEvent.RangeDescriptor
    If Len(Trim(sDesc)) = 0 Then Exit Function

    &apos; e.g. &quot;$Sheet1.$A$10&quot; : the last &quot;.&quot; separates sheet name and cell
    p = 0
    For i = Len(sDesc) To 1 Step -1
        If Mid(sDesc, i, 1) = &quot;.&quot; Then
            p = i
            Exit For
        End If
    Next i
    If p &gt; 0 Then
        sSheetName = Left(sDesc, p - 1)
        sSheetName = Replace(sSheetName, &quot;$&quot;, &quot;&quot;)
        sSheetName = Replace(sSheetName, &quot;&apos;&quot;, &quot;&quot;)
        sCell = Mid(sDesc, p + 1)
        oSheet = oDoc.Sheets.getByName(sSheetName)
    Else
        sCell = sDesc
        oSheet = oDoc.Sheets.getByIndex(nDefSheet)
    End If
    If Len(Trim(sCell)) = 0 Then Exit Function

    oRange = oSheet.getCellRangeByName(sCell)
    oA = oRange.RangeAddress
    ResolveDestination = Array(CLng(oA.Sheet), CLng(oA.StartColumn), CLng(oA.StartRow), _
                                CLng(oA.EndColumn), CLng(oA.EndRow))
    Exit Function

Bad:
    &apos; returns Empty
End Function

&apos; Reopens the &quot;click the destination&quot; window after a bad click
Function RetryPick(oDoc As Object, a() As String) As Boolean
    RetryPick = False
    On Error GoTo Fail
    StartDestinationPick oDoc.CurrentController, _
        BuildTitle(a(0), (a(2) = &quot;1&quot;), (a(3) = &quot;1&quot;), (a(4) = &quot;1&quot;))
    RetryPick = True
    Exit Function
Fail:
    ClearState oDoc
    MsgBox Txt(&quot;msg.noreopen&quot;), 48
End Function

Sub RS_done(oEvent As Object)
    Dim oDoc As Object, vT As Variant
    Dim oSA As New com.sun.star.table.CellRangeAddress
    Dim sState As String, sBase As String, a() As String
    Dim j As Long, sStep As String
    Dim sErr As String, nLine As Long
    On Error GoTo Oops

    sStep = Txt(&quot;step.load&quot;)
    oDoc = ThisComponent
    sState = LoadState(oDoc)
    If sState = &quot;&quot; Then Exit Sub          &apos; nothing pending (or already handled)
    a = Split(sState, &quot;|&quot;)

    &apos; another registered listener already rejected this same click a moment ago
    If UBound(a) &gt;= 7 Then
        If Abs(CLng(Timer) - CLng(a(7))) &lt;= 1 Then Exit Sub
    End If

    &apos; --- check the destination BEFORE touching anything ---
    sStep = Txt(&quot;step.read&quot;)
    vT = ResolveDestination(oDoc, oEvent, CLng(a(5)))
    If Not IsArray(vT) Then
        MsgBox Txt(&quot;msg.point1&quot;) &amp; Chr(10) &amp; Chr(10) &amp; _
               Txt(&quot;msg.point2&quot;) &amp; Chr(10) &amp; _
               Txt(&quot;msg.point3&quot;), 48
        If RetryPick(oDoc, a) Then
            &apos; remember when this click was rejected so other listeners skip it
            sBase = a(0)
            For j = 1 To 6
                sBase = sBase &amp; &quot;|&quot; &amp; a(j)
            Next j
            SaveState oDoc, sBase &amp; &quot;|&quot; &amp; CLng(Timer)
        End If
        Exit Sub
    End If

    sStep = Txt(&quot;step.prepare&quot;)
    ClearState oDoc

    &apos; --- copy sheets: the destination is the sheet of the click ---
    If a(0) = &quot;SHEETS&quot; Then
        sStep = Txt(&quot;step.run&quot;)
        PerformSheetCopy a(6), (a(2) = &quot;1&quot;), CLng(vT(0))
        Exit Sub
    End If

    &apos; --- rebuild the source description ---
    sSrcMode = a(0)
    bCutMode = (a(1) = &quot;1&quot; Or a(1) = &quot;2&quot;)     &apos; cut and move both relocate the content
    bMoveMode = (a(1) = &quot;2&quot;)                  &apos; move: the source cells are kept, only emptied
    bBeforeMode = (a(2) = &quot;1&quot;)
    bSpecialMode = (a(3) = &quot;1&quot;)
    bShiftRight = (a(4) = &quot;1&quot;)
    oSA.Sheet = CInt(a(5))
    aSrcRanges = StringToRanges(a(6))
    oSA.StartColumn = aSrcRanges(0, 0) : oSA.StartRow = aSrcRanges(1, 0)
    oSA.EndColumn = aSrcRanges(2, 0)   : oSA.EndRow = aSrcRanges(3, 0)
    oSrcAddr = oSA                       &apos; first range (the only one for cells)
    oSrcDoc = oDoc

    sStep = Txt(&quot;step.run&quot;)
    If bSpecialMode Then
        PerformPasteSpecial CLng(vT(0)), CLng(vT(1)), CLng(vT(2)), CLng(vT(3)), CLng(vT(4))
    Else
        PerformInsert CLng(vT(0)), CLng(vT(1)), CLng(vT(2)), CLng(vT(3)), CLng(vT(4))
    End If
    Exit Sub

Oops:
    sErr = Error$ : nLine = Erl
    MsgBox Txt(&quot;err.range&quot;) &amp; nLine &amp; Txt(&quot;err.while&quot;) &amp; sStep &amp; &quot;)&quot; &amp; Txt(&quot;err.sep&quot;) &amp; sErr, 16
End Sub

Sub RS_aborted(oEvent As Object)
    ClearState ThisComponent
End Sub

&apos; Sheets: the active sheet changed. While a sheet copy waits for its destination, this is a
&apos; click on a sheet tab: that sheet is the destination. (The listener stays registered, so
&apos; with no sheet copy pending it does nothing.)
Sub AS_activeSpreadsheetChanged(oEvent As Object)
    Dim oDoc As Object, sState As String, a() As String, nDest As Long
    Dim sErr As String, nLine As Long
    On Error GoTo Oops

    oDoc = ThisComponent
    If Not IsCalcDoc(oDoc) Then Exit Sub
    sState = LoadState(oDoc)
    If Left(sState, 7) &lt;&gt; &quot;SHEETS|&quot; Then Exit Sub      &apos; no sheet copy waiting
    a = Split(sState, &quot;|&quot;)
    nDest = oEvent.ActiveSheet.RangeAddress.Sheet

    ClearState oDoc                                     &apos; handled: nothing pending any more
    On Error Resume Next
    oDoc.CurrentController.abortRangeSelection()        &apos; closes the destination window
    On Error GoTo Oops
    PerformSheetCopy a(6), (a(2) = &quot;1&quot;), nDest
    Exit Sub

Oops:
    sErr = Error$ : nLine = Erl
    MsgBox Txt(&quot;err.range&quot;) &amp; nLine &amp; Txt(&quot;err.sep&quot;) &amp; sErr, 16
End Sub

Sub AS_disposing(oEvent As Object)
End Sub

Sub RS_disposing(oEvent As Object)
End Sub


&apos;=====================================================================
&apos;  6. Copy / Cut / Move: do the work (Cut and Move use moveRange so formulas follow)
&apos;     Cut removes the emptied source rows / columns / cells afterwards,
&apos;     Move leaves them in place (empty).
&apos;     The destination arrives as plain numbers (tSheet, tC1, tR1, tC2, tR2)
&apos;=====================================================================
&apos; Move: moveRange carries the formatting away with the data and leaves the emptied source
&apos; unformatted. A move must only empty the source cells, so right after moveRange the
&apos; formatting of the moved data (now at the destination oD) is copied back onto the source
&apos; range oS and the content that came with it is cleared again. Formatting stays, content goes.
Sub KeepSourceFormat(oSrcSheet As Object, oDstSheet As Object, oD As Object, oS As Object)
    Dim oFrom As New com.sun.star.table.CellRangeAddress
    Dim oBack As New com.sun.star.table.CellAddress
    Dim nContent As Long

    nContent = com.sun.star.sheet.CellFlags.VALUE + com.sun.star.sheet.CellFlags.DATETIME + _
               com.sun.star.sheet.CellFlags.STRING + com.sun.star.sheet.CellFlags.ANNOTATION + _
               com.sun.star.sheet.CellFlags.FORMULA + com.sun.star.sheet.CellFlags.OBJECTS
    oFrom.Sheet = oD.Sheet
    oFrom.StartColumn = oD.Column : oFrom.StartRow = oD.Row
    oFrom.EndColumn = oD.Column + (oS.EndColumn - oS.StartColumn)
    oFrom.EndRow = oD.Row + (oS.EndRow - oS.StartRow)
    oBack.Sheet = oS.Sheet : oBack.Column = oS.StartColumn : oBack.Row = oS.StartRow
    oDstSheet.copyRange(oBack, oFrom)
    oSrcSheet.getCellRangeByPosition(oS.StartColumn, oS.StartRow, oS.EndColumn, oS.EndRow).clearContents(nContent)
End Sub

Sub PerformInsert(tSheet As Long, tC1 As Long, tR1 As Long, tC2 As Long, tR2 As Long)
    Dim oDoc As Object, oSrcSheet As Object, oDstSheet As Object
    Dim oT As New com.sun.star.table.CellRangeAddress
    Dim oS As New com.sun.star.table.CellRangeAddress
    Dim oD As New com.sun.star.table.CellAddress
    Dim oIns As New com.sun.star.table.CellRangeAddress
    Dim bSame As Boolean, bOverlap As Boolean, bRemove As Boolean
    Dim nIns As Long, nW As Long, nH As Long, nCol As Long, nRow As Long
    Dim nR1 As Long, nR2 As Long, nC1 As Long, nC2 As Long   &apos; final position of the pasted data
    Dim bUndo As Boolean, sErr As String, nLine As Long
    Dim aSr As Variant, nB As Long, i As Long, nTot As Long, nOff As Long
    Dim nSt As Long, nEn As Long, nLen As Long, nAbove As Long

    On Error GoTo ErrHandler

    aSr = aSrcRanges                        &apos; all the source ranges (rows and columns: sheet order)
    nB = UBound(aSr, 2) + 1
    oT.Sheet = tSheet
    oT.StartColumn = tC1 : oT.StartRow = tR1
    oT.EndColumn = tC2 : oT.EndRow = tR2

    oDoc = oSrcDoc
    DelDocProp oDoc, PSSRC_NAME            &apos; forget any paste special that was cancelled earlier
    bSame = (oSrcAddr.Sheet = oT.Sheet)
    bRemove = bCutMode And Not bMoveMode   &apos; only a cut removes the emptied source
    oSrcSheet = oDoc.Sheets.getByIndex(oSrcAddr.Sheet)
    oDstSheet = oDoc.Sheets.getByIndex(oT.Sheet)

    oS.Sheet = oSrcAddr.Sheet
    oS.StartColumn = oSrcAddr.StartColumn : oS.EndColumn = oSrcAddr.EndColumn
    oS.StartRow = oSrcAddr.StartRow : oS.EndRow = oSrcAddr.EndRow
    nW = oS.EndColumn - oS.StartColumn + 1
    nH = oS.EndRow - oS.StartRow + 1

    Select Case sSrcMode
    &apos;---------------------------------------------------------------- ROWS
    &apos; One or several ranges of complete rows. Room is made for all of them together, then
    &apos; each range goes into the new rows in turn: consecutive, in sheet order.
    Case &quot;ROWS&quot;
        If bBeforeMode Then nIns = oT.StartRow Else nIns = oT.EndRow + 1
        nTot = 0 : nAbove = 0
        For i = 0 To nB - 1
            nLen = aSr(3, i) - aSr(1, i) + 1
            nTot = nTot + nLen
            If bSame Then
                If nIns &gt; aSr(1, i) And nIns &lt;= aSr(3, i) Then GoTo InsideSource
                If nIns &gt; aSr(3, i) Then nAbove = nAbove + nLen   &apos; emptied rows above the destination
            End If
        Next i
        oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.rows&quot;)) : bUndo = True

        oDstSheet.Rows.insertByIndex(nIns, nTot)
        nOff = 0
        For i = 0 To nB - 1
            nLen = aSr(3, i) - aSr(1, i) + 1
            nSt = aSr(1, i) : nEn = aSr(3, i)
            If bSame And nIns &lt;= nSt Then               &apos; this range moved down with the insertion
                nSt = nSt + nTot : nEn = nEn + nTot
            End If
            oS.StartColumn = 0 : oS.EndColumn = oSrcSheet.Columns.Count - 1
            oS.StartRow = nSt  : oS.EndRow = nEn
            oD.Sheet = oT.Sheet : oD.Column = 0 : oD.Row = nIns + nOff
            If bCutMode Then
                oSrcSheet.moveRange(oD, oS)                    &apos; references follow the moved cells
                If bMoveMode Then KeepSourceFormat oSrcSheet, oDstSheet, oD, oS
            Else
                oSrcSheet.copyRange(oD, oS)
            End If
            nOff = nOff + nLen
        Next i
        If bRemove Then                                        &apos; cut: remove the emptied rows, last first
            For i = nB - 1 To 0 Step -1
                nLen = aSr(3, i) - aSr(1, i) + 1
                nSt = aSr(1, i)
                If bSame And nIns &lt;= nSt Then nSt = nSt + nTot
                oSrcSheet.Rows.removeByIndex(nSt, nLen)
            Next i
        End If

        &apos; final position: shifts up by the removed rows that were above the destination
        nR1 = nIns
        If bRemove And bSame Then nR1 = nIns - nAbove
        nR2 = nR1 + nTot - 1
        nC1 = 0 : nC2 = oDstSheet.Columns.Count - 1

    &apos;---------------------------------------------------------------- COLS
    Case &quot;COLS&quot;
        If bBeforeMode Then nIns = oT.StartColumn Else nIns = oT.EndColumn + 1
        nTot = 0 : nAbove = 0
        For i = 0 To nB - 1
            nLen = aSr(2, i) - aSr(0, i) + 1
            nTot = nTot + nLen
            If bSame Then
                If nIns &gt; aSr(0, i) And nIns &lt;= aSr(2, i) Then GoTo InsideSource
                If nIns &gt; aSr(2, i) Then nAbove = nAbove + nLen   &apos; emptied columns left of the destination
            End If
        Next i
        oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.columns&quot;)) : bUndo = True

        oDstSheet.Columns.insertByIndex(nIns, nTot)
        nOff = 0
        For i = 0 To nB - 1
            nLen = aSr(2, i) - aSr(0, i) + 1
            nSt = aSr(0, i) : nEn = aSr(2, i)
            If bSame And nIns &lt;= nSt Then
                nSt = nSt + nTot : nEn = nEn + nTot
            End If
            oS.StartRow = 0     : oS.EndRow = oSrcSheet.Rows.Count - 1
            oS.StartColumn = nSt : oS.EndColumn = nEn
            oD.Sheet = oT.Sheet : oD.Column = nIns + nOff : oD.Row = 0
            If bCutMode Then
                oSrcSheet.moveRange(oD, oS)
                If bMoveMode Then KeepSourceFormat oSrcSheet, oDstSheet, oD, oS
            Else
                oSrcSheet.copyRange(oD, oS)
            End If
            nOff = nOff + nLen
        Next i
        If bRemove Then
            For i = nB - 1 To 0 Step -1
                nLen = aSr(2, i) - aSr(0, i) + 1
                nSt = aSr(0, i)
                If bSame And nIns &lt;= nSt Then nSt = nSt + nTot
                oSrcSheet.Columns.removeByIndex(nSt, nLen)
            Next i
        End If

        nC1 = nIns
        If bRemove And bSame Then nC1 = nIns - nAbove
        nC2 = nC1 + nTot - 1
        nR1 = 0 : nR2 = oDstSheet.Rows.Count - 1

    &apos;---------------------------------------------------------------- CELLS
    Case &quot;CELLS&quot;
        If Not bShiftRight Then
            &apos;----- below / above: existing cells shift down -----
            nCol = oT.StartColumn
            If bBeforeMode Then nRow = oT.StartRow Else nRow = oT.EndRow + 1
            oIns.Sheet = oT.Sheet
            oIns.StartColumn = nCol : oIns.EndColumn = nCol + nW - 1
            oIns.StartRow = nRow : oIns.EndRow = nRow + nH - 1
            bOverlap = bSame And (nCol &lt;= oS.EndColumn) And (nCol + nW - 1 &gt;= oS.StartColumn)
            If bOverlap And nRow &gt; oS.StartRow And nRow &lt;= oS.EndRow Then GoTo InsideSource
            oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.cells&quot;)) : bUndo = True

            oDstSheet.insertCells(oIns, com.sun.star.sheet.CellInsertMode.DOWN)
            If bOverlap And nRow &lt;= oS.StartRow Then
                oS.StartRow = oS.StartRow + nH : oS.EndRow = oS.EndRow + nH
            End If
            oD.Sheet = oT.Sheet : oD.Column = nCol : oD.Row = nRow
            If bCutMode Then
                oSrcSheet.moveRange(oD, oS)
                If bMoveMode Then KeepSourceFormat oSrcSheet, oDstSheet, oD, oS
                If bRemove Then oSrcSheet.removeRange(oS, com.sun.star.sheet.CellDeleteMode.UP)
            Else
                oSrcSheet.copyRange(oD, oS)
            End If

            nR1 = nRow
            If bRemove And bOverlap And nRow &gt; oS.EndRow Then nR1 = nRow - nH
            nR2 = nR1 + nH - 1
            nC1 = nCol : nC2 = nCol + nW - 1
        Else
            &apos;----- right / left: existing cells shift right -----
            If bBeforeMode Then nCol = oT.StartColumn Else nCol = oT.EndColumn + 1
            nRow = oT.StartRow
            oIns.Sheet = oT.Sheet
            oIns.StartColumn = nCol : oIns.EndColumn = nCol + nW - 1
            oIns.StartRow = nRow : oIns.EndRow = nRow + nH - 1
            bOverlap = bSame And (nRow &lt;= oS.EndRow) And (nRow + nH - 1 &gt;= oS.StartRow)
            If bOverlap And nCol &gt; oS.StartColumn And nCol &lt;= oS.EndColumn Then GoTo InsideSource
            oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.cells&quot;)) : bUndo = True

            oDstSheet.insertCells(oIns, com.sun.star.sheet.CellInsertMode.RIGHT)
            If bOverlap And nCol &lt;= oS.StartColumn Then
                oS.StartColumn = oS.StartColumn + nW : oS.EndColumn = oS.EndColumn + nW
            End If
            oD.Sheet = oT.Sheet : oD.Column = nCol : oD.Row = nRow
            If bCutMode Then
                oSrcSheet.moveRange(oD, oS)
                If bMoveMode Then KeepSourceFormat oSrcSheet, oDstSheet, oD, oS
                If bRemove Then oSrcSheet.removeRange(oS, com.sun.star.sheet.CellDeleteMode.LEFT)
            Else
                oSrcSheet.copyRange(oD, oS)
            End If

            nC1 = nCol
            If bRemove And bOverlap And nCol &gt; oS.EndColumn Then nC1 = nCol - nW
            nC2 = nC1 + nW - 1
            nR1 = nRow : nR2 = nRow + nH - 1
        End If
    End Select

    oDoc.UndoManager.leaveUndoContext()
    bUndo = False

    &apos; --- remember the ORIGINAL source so an Undo can select it again ---
    On Error Resume Next
    SetDocProp oDoc, UNDO_NAME, oSrcAddr.Sheet &amp; &quot;|&quot; &amp; RangesToString(aSrcRanges)
    On Error GoTo 0

    &apos; --- select the pasted data (on its own sheet) ---
    On Error Resume Next
    oDoc.CurrentController.setActiveSheet(oDstSheet)
    oDoc.CurrentController.select(oDstSheet.getCellRangeByPosition(nC1, nR1, nC2, nR2))
    On Error GoTo 0
    Exit Sub

InsideSource:
    MsgBox Txt(&quot;msg.inside&quot;), 48
    Exit Sub

ErrHandler:
    sErr = Error$ : nLine = Erl
    If bUndo Then oDoc.UndoManager.leaveUndoContext()
    MsgBox Txt(&quot;err.general&quot;) &amp; nLine &amp; Txt(&quot;err.sep&quot;) &amp; sErr, 16
End Sub


&apos;=====================================================================
&apos;  6b. Copy sheets and insert
&apos;      The selected sheets are copied as one block before / after the destination sheet.
&apos;      1) copyByName makes every copy (tab color, column widths, page style ... come with
&apos;         it), all the copies being in place before anything else is done;
&apos;      2) the used area of each source is then pasted on its copy with copyRange. The
&apos;         references between sheets are adjusted by the paste, exactly as for any cells:
&apos;         a relative reference to a sheet of the block follows the block.
&apos;=====================================================================
&apos; A sheet name based on sBase that is neither in the document nor in aTaken(0 .. nTaken-1)
Function FreeSheetName(oSheets As Object, sBase As String, aTaken() As String, nTaken As Long) As String
    Dim k As Long, j As Long, sTry As String, bTaken As Boolean
    k = 2
    Do
        sTry = sBase &amp; &quot;_&quot; &amp; k
        bTaken = oSheets.hasByName(sTry)
        For j = 0 To nTaken - 1
            If aTaken(j) = sTry Then bTaken = True
        Next j
        If Not bTaken Then Exit Do
        k = k + 1
    Loop
    FreeSheetName = sTry
End Function

&apos; Makes the sheet number nIdx the active sheet and the ONLY selected one, with the ranges
&apos; sRanges (&quot;c1,r1,c2,r2;...&quot;) highlighted, or cell A1 if there are none. Selecting
&apos; a cell is not enough: the sheet tabs that were selected stay marked without being shown
&apos; as selected, and then whatever is typed in a cell goes to all those sheets. Deselecting
&apos; all the sheets (Deselect All Sheets, which keeps the active sheet) clears those marks.
Sub SelectFirstSheet(oDoc As Object, nIdx As Long, sRanges As String)
    Dim oCtrl As Object, oSheet As Object, oDisp As Object, aR As Variant
    Dim aArgs(0) As New com.sun.star.beans.PropertyValue
    On Error Resume Next
    oCtrl = oDoc.CurrentController
    oSheet = oDoc.Sheets.getByIndex(nIdx)
    oCtrl.setActiveSheet(oSheet)
    oDisp = createUnoService(&quot;com.sun.star.frame.DispatchHelper&quot;)
    oDisp.executeDispatch(oCtrl.Frame, &quot;.uno:TableDeselectAll&quot;, &quot;&quot;, 0, Array())
    If sRanges = &quot;&quot; Then
        sRanges = &quot;0,0,0,0&quot;
    End If
    aR = StringToRanges(sRanges)
    If UBound(aR, 2) = 0 And aR(0, 0) = aR(2, 0) And aR(1, 0) = aR(3, 0) Then
        &apos; one cell: only the cell cursor goes there (like a click), it is not highlighted
        &apos; as a selected range, which is what select() would do
        aArgs(0).Name = &quot;ToPoint&quot;
        aArgs(0).Value = oSheet.getCellByPosition(aR(0, 0), aR(1, 0)).AbsoluteName
        oDisp.executeDispatch(oCtrl.Frame, &quot;.uno:GoToCell&quot;, &quot;&quot;, 0, aArgs())
    Else
        oCtrl.select(BuildSelection(oDoc, nIdx, aR))
    End If
End Sub

&apos; True if copies inserted at position nPos (they become sheet number nPos, so they go
&apos; before the sheet that is at nPos now) do not fall inside the range of the sheets
&apos; nFirst .. nLast that are copied: that is before the first one or after the last one.
Function SheetInsertAllowed(nPos As Long, nFirst As Long, nLast As Long) As Boolean
    SheetInsertAllowed = Not (nPos &gt; nFirst And nPos &lt;= nLast)
End Function

&apos; sIdx = indexes of the source sheets &quot;1,2,5&quot;; tSheet = index of the destination sheet
Sub PerformSheetCopy(sIdx As String, bBefore As Boolean, tSheet As Long)
    Dim oDoc As Object, oSheets As Object, oSrc As Object, oCur As Object
    Dim aIdx() As String, aOld() As String, aNew() As String
    Dim oD As New com.sun.star.table.CellAddress
    Dim n As Long, i As Long, nPos As Long, bUndo As Boolean
    Dim sErr As String, nLine As Long

    On Error GoTo ErrHandler
    oDoc = ThisComponent
    oSheets = oDoc.Sheets
    Dim sList As String, sRg As String, nAt As Long
    nAt = InStr(sIdx, &quot;@&quot;)                  &apos; &quot;1,2@c1,r1,c2,r2&quot; = sheets @ highlighted ranges
    If nAt &gt; 0 Then
        sList = Left(sIdx, nAt - 1)
        sRg = Mid(sIdx, nAt + 1)
    Else
        sList = sIdx
        sRg = &quot;&quot;
    End If
    aIdx = Split(sList, &quot;,&quot;)
    n = UBound(aIdx) + 1
    ReDim aOld(n - 1) As String
    ReDim aNew(n - 1) As String
    For i = 0 To n - 1
        aOld(i) = oSheets.getByIndex(CLng(aIdx(i))).Name
        aNew(i) = FreeSheetName(oSheets, aOld(i), aNew, i)
    Next i
    nPos = tSheet
    If Not bBefore Then nPos = nPos + 1

    &apos; never inside the range of the copied sheets: it would break the references between them
    If Not SheetInsertAllowed(nPos, CLng(aIdx(0)), CLng(aIdx(n - 1))) Then
        MsgBox Txt(&quot;msg.sheetinside&quot;), 48
        Exit Sub
    End If

    oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.sheets&quot;)) : bUndo = True

    &apos; 1) the copies, in order (the sources are found again by name: indexes move)
    For i = 0 To n - 1
        oSheets.copyByName(aOld(i), aNew(i), nPos + i)
    Next i

    &apos; 2) the cells of every source onto its copy
    For i = 0 To n - 1
        oSrc = oSheets.getByName(aOld(i))
        oCur = oSrc.createCursor()
        oCur.gotoStartOfUsedArea(False)
        oCur.gotoEndOfUsedArea(True)
        oD.Sheet = oSheets.getByName(aNew(i)).RangeAddress.Sheet
        oD.Column = 0 : oD.Row = 0
        oSrc.copyRange(oD, oCur.RangeAddress)
    Next i

    oDoc.UndoManager.leaveUndoContext()
    bUndo = False

    &apos; remember the ORIGINAL sheets so an Undo can select the first one again, and select
    &apos; the first copy (that sheet only)
    On Error Resume Next
    SetDocProp oDoc, UNDO_NAME, &quot;S|&quot; &amp; sIdx
    SelectFirstSheet oDoc, nPos, sRg
    On Error GoTo 0
    Exit Sub

ErrHandler:
    sErr = Error$ : nLine = Erl
    If bUndo Then oDoc.UndoManager.leaveUndoContext()
    MsgBox Txt(&quot;err.general&quot;) &amp; nLine &amp; Txt(&quot;err.sep&quot;) &amp; sErr, 16
End Sub


&apos;=====================================================================
&apos;  7. Paste Special: copy to the clipboard, make room, open the dialog
&apos;     The destination arrives as plain numbers (tSheet, tC1, tR1, tC2, tR2)
&apos;=====================================================================
&apos; Lets LibreOffice handle its pending events (such as the news that the clipboard changed)
Sub LetOfficeCatchUp(nMs As Long)
    On Error Resume Next
    createUnoService(&quot;com.sun.star.awt.Toolkit&quot;).processEventsToIdle()
    On Error GoTo 0
    Wait nMs
End Sub

&apos; Opens the Paste Special dialog. The call normally returns only when the dialog is closed.
&apos; If it comes back at once, LibreOffice ignored it: in the first use of a session it may not
&apos; have noticed yet that the clipboard holds something. So let it catch up and try again.
Function OpenPasteSpecial(oFrame As Object, oDisp As Object) As Boolean
    Dim nTry As Long, t0 As Double, t1 As Double
    OpenPasteSpecial = False
    For nTry = 1 To 6
        t0 = Timer
        oDisp.executeDispatch(oFrame, &quot;.uno:PasteSpecial&quot;, &quot;&quot;, 0, Array())
        t1 = Timer
        If t1 &lt; t0 Or t1 - t0 &gt; 0.5 Then
            OpenPasteSpecial = True
            Exit Function
        End If
        LetOfficeCatchUp 250
    Next nTry
End Function

Sub PerformPasteSpecial(tSheet As Long, tC1 As Long, tR1 As Long, tC2 As Long, tR2 As Long)
    Dim oDoc As Object, oCtrl As Object, oFrame As Object, oDisp As Object
    Dim oSrcSheet As Object, oDstSheet As Object
    Dim oT As New com.sun.star.table.CellRangeAddress
    Dim oIns As New com.sun.star.table.CellRangeAddress
    Dim nIns As Long, nW As Long, nH As Long, nCol As Long, nRow As Long
    Dim nR1 As Long, nR2 As Long, nC1 As Long, nC2 As Long
    Dim sKind As String, bSame As Boolean, bOverlap As Boolean, bUndo As Boolean
    Dim sErr As String, nLine As Long
    Dim nTot As Long, i As Long
    &apos; source ranges as they sit AFTER the insertion (they move if the space is made above /
    &apos; left of them): aP(field, index)
    Dim aP As Variant

    On Error GoTo ErrHandler

    oT.Sheet = tSheet
    oT.StartColumn = tC1 : oT.StartRow = tR1
    oT.EndColumn = tC2 : oT.EndRow = tR2

    oDoc = oSrcDoc
    oCtrl = oDoc.CurrentController
    oFrame = oCtrl.Frame
    oSrcSheet = oDoc.Sheets.getByIndex(oSrcAddr.Sheet)
    oDstSheet = oDoc.Sheets.getByIndex(oT.Sheet)
    bSame = (oSrcAddr.Sheet = oT.Sheet)
    nW = oSrcAddr.EndColumn - oSrcAddr.StartColumn + 1      &apos; cells: the one range
    nH = oSrcAddr.EndRow - oSrcAddr.StartRow + 1
    aP = CopyRanges(aSrcRanges)

    &apos; forget leftovers from an earlier paste special
    DelDocProp oDoc, PSSRC_NAME

    &apos; --- 1. copy the source to the real clipboard (all its ranges, for a Ctrl selection) ---
    oCtrl.setActiveSheet(oSrcSheet)
    oCtrl.select(BuildSelection(oDoc, oSrcAddr.Sheet, aSrcRanges))
    oDisp = createUnoService(&quot;com.sun.star.frame.DispatchHelper&quot;)
    oDisp.executeDispatch(oFrame, &quot;.uno:Copy&quot;, &quot;&quot;, 0, Array())
    LetOfficeCatchUp 100

    &apos; --- 2. make room at the destination (one Undo step with our title) ---
    Select Case sSrcMode
    Case &quot;ROWS&quot;
        sKind = &quot;rows&quot;
        If bBeforeMode Then nIns = oT.StartRow Else nIns = oT.EndRow + 1
        nTot = TotalSize(aSrcRanges, 1)
        oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.&quot; &amp; sKind)) : bUndo = True
        oDstSheet.Rows.insertByIndex(nIns, nTot)
        If bSame Then
            For i = 0 To UBound(aP, 2)
                If nIns &lt;= aSrcRanges(1, i) Then
                    aP(1, i) = aP(1, i) + nTot : aP(3, i) = aP(3, i) + nTot
                End If
            Next i
        End If
        nC1 = 0 : nC2 = oDstSheet.Columns.Count - 1
        nR1 = nIns : nR2 = nIns + nTot - 1

    Case &quot;COLS&quot;
        sKind = &quot;columns&quot;
        If bBeforeMode Then nIns = oT.StartColumn Else nIns = oT.EndColumn + 1
        nTot = TotalSize(aSrcRanges, 0)
        oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.&quot; &amp; sKind)) : bUndo = True
        oDstSheet.Columns.insertByIndex(nIns, nTot)
        If bSame Then
            For i = 0 To UBound(aP, 2)
                If nIns &lt;= aSrcRanges(0, i) Then
                    aP(0, i) = aP(0, i) + nTot : aP(2, i) = aP(2, i) + nTot
                End If
            Next i
        End If
        nC1 = nIns : nC2 = nIns + nTot - 1
        nR1 = 0 : nR2 = oDstSheet.Rows.Count - 1

    Case &quot;CELLS&quot;
        sKind = &quot;cells&quot;
        oIns.Sheet = oT.Sheet
        If Not bShiftRight Then
            nCol = oT.StartColumn
            If bBeforeMode Then nRow = oT.StartRow Else nRow = oT.EndRow + 1
        Else
            If bBeforeMode Then nCol = oT.StartColumn Else nCol = oT.EndColumn + 1
            nRow = oT.StartRow
        End If
        oIns.StartColumn = nCol : oIns.EndColumn = nCol + nW - 1
        oIns.StartRow = nRow : oIns.EndRow = nRow + nH - 1
        oDoc.UndoManager.enterUndoContext(UndoPrefix() &amp; Txt(&quot;undo.&quot; &amp; sKind)) : bUndo = True
        If Not bShiftRight Then
            oDstSheet.insertCells(oIns, com.sun.star.sheet.CellInsertMode.DOWN)
            bOverlap = bSame And (nCol &lt;= oSrcAddr.EndColumn) And (nCol + nW - 1 &gt;= oSrcAddr.StartColumn)
            If bOverlap And nRow &lt;= oSrcAddr.StartRow Then
                aP(1, 0) = aP(1, 0) + nH : aP(3, 0) = aP(3, 0) + nH
            End If
        Else
            oDstSheet.insertCells(oIns, com.sun.star.sheet.CellInsertMode.RIGHT)
            bOverlap = bSame And (nRow &lt;= oSrcAddr.EndRow) And (nRow + nH - 1 &gt;= oSrcAddr.StartRow)
            If bOverlap And nCol &lt;= oSrcAddr.StartColumn Then
                aP(0, 0) = aP(0, 0) + nW : aP(2, 0) = aP(2, 0) + nW
            End If
        End If
        nC1 = nCol : nC2 = nCol + nW - 1
        nR1 = nRow : nR2 = nRow + nH - 1
    End Select

    oDoc.UndoManager.leaveUndoContext()
    bUndo = False

    &apos; --- remember the source for the two Undo steps (insertion, then paste) ---
    On Error Resume Next
    SetDocProp oDoc, UNDO_NAME, oSrcAddr.Sheet &amp; &quot;|&quot; &amp; RangesToString(aSrcRanges)
    SetDocProp oDoc, PSSRC_NAME, oSrcAddr.Sheet &amp; &quot;|&quot; &amp; RangesToString(aP)
    On Error GoTo ErrHandler

    &apos; --- 3. select the empty space and open Paste Special ---
    oCtrl.setActiveSheet(oDstSheet)
    oCtrl.select(oDstSheet.getCellRangeByPosition(nC1, nR1, nC2, nR2))
    If Not OpenPasteSpecial(oFrame, oDisp) Then MsgBox Txt(&quot;msg.pastefail&quot;), 48
    Exit Sub

ErrHandler:
    sErr = Error$ : nLine = Erl
    If bUndo Then oDoc.UndoManager.leaveUndoContext()
    MsgBox Txt(&quot;err.general&quot;) &amp; nLine &amp; Txt(&quot;err.sep&quot;) &amp; sErr, 16
End Sub
</script:module>